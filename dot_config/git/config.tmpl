[user]
	useConfigOnly = true
[push]
	autoSetupRemote = true
	default = simple
[pull]
	rebase = merges
[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
[alias]
	co = checkout
	ci = commit
	st = status
	staged = diff --cached
	unstage = restore --staged
	push-please = push --force-with-lease
	hist = log --graph --pretty=format:'%C(red)%h%C(reset)%C(yellow)%d%C(reset) %s %C(green)(%ad)%C(reset) %C(blue)<%aN>%C(reset)' --date=format:'%Y-%m-%d %I:%M %p'
	hst = hist -n 10
	fixup = commit --amend --no-edit
	rewrite = rebase --committer-date-is-author-date
	ls-stack = log --reverse --decorate-refs=refs/heads/ --simplify-by-decoration --format=%D origin/main..HEAD
[advice]
	detachedHead = false
[help]
	autoCorrect = -1
[color "status"]
	added = green
	changed = yellow
	untracked = red
[core]
	pager = delta
	fileMode = false
	fsmonitor = true
[feature]
	manyFiles = true
[maintenance]
	repo = {{ .chezmoi.homeDir }}/work/discord
[maintenance "prefetch"]
	enabled = false
[include]
	path = ~/.config/delta/rose-pine.gitconfig
[interactive]
	diffFilter = delta --color-only
[color]
	status = always
	ui = always
[url "git@github.com:"]
	insteadOf = gh://
[init]
	defaultBranch = main
[diff]
	colorMoved = default
[merge]
	autoStash = true
	conflictstyle = zdiff3
[fetch]
	prune = true
[delta]
	line-numbers = true
	navigate = true
	true-color = always
	features = dark-mode
[delta "light-mode"]
	light = true
	features = rose-pine-dawn
	syntax-theme = rose-pine-dawn
[delta "dark-mode"]
	dark = true
	features = rose-pine-moon
	syntax-theme = rose-pine-moon
[rerere]
	enabled = 1
